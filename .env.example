# ==============================================================================
# HVAC Copilot - Environment Variables
# ==============================================================================
# Copy this to .env and fill in your values

# ==============================================================================
# REQUIRED - Core Services
# ==============================================================================

# Google API Key (Gemini)
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key

# Supabase
# Get from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

# LiveKit (for Call Mode - real-time video)
# Get from: https://cloud.livekit.io
LIVEKIT_URL=wss://your-app.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# ==============================================================================
# OPTIONAL - Payments & Extras
# ==============================================================================

# Stripe (for Pro subscriptions)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO=price_...

# OpenAI (fallback if Gemini not available)
OPENAI_API_KEY=sk-...

# ==============================================================================
# SERVER CONFIG
# ==============================================================================

HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# ==============================================================================
# LEGACY (Guide module - being phased out)
# ==============================================================================

# Anthropic API key (for legacy Claude-based vision)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Default model for legacy guide
DEFAULT_MODEL=claude-sonnet-4-20250514

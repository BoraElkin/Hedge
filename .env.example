# Required: Anthropic API key for Claude vision + reasoning
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: OpenAI for text-to-speech (Whisper STT is free, TTS is paid)
OPENAI_API_KEY=your-openai-api-key

# Server config
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Guide settings
DEFAULT_MODEL=claude-sonnet-4-20250514
MAX_IMAGES_PER_SESSION=100
SESSION_TIMEOUT_MINUTES=60

# --- Messaging Bridges ---

# Twilio (SMS + WhatsApp)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=+1234567890

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# --- MCP Integrations ---

# Home Assistant (smart device control)
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=your-long-lived-access-token

# Parts Database (optional external)
PARTS_API_URL=
PARTS_API_KEY=
